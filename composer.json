{
  "name": "wearesho-team/yii2-message-delivery",
  "description": "Message Delivery Yii2 Implementation",
  "type": "library",
  "require-dev": {
    "ext-json": "*",
    "horat1us/yii2-asset-free": "^1.1",
    "phpunit/phpunit": "^13.4",
    "squizlabs/php_codesniffer": "^4.0",
    "yiisoft/yii2-queue": "^2.3.8"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Alexander Letnikow",
      "email": "reclamme@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.4",
    "horat1us/environment-config": "^1.6",
    "horat1us/yii2-carbon-behavior": "^1.4",
    "horat1us/yii2-environment-config": "^1.2",
    "horat1us/yii2-migration-bootstrap": "^1.4",
    "horat1us/yii2-validation-exception": "^1.2",
    "nesbot/carbon": "^3.2 || ^2.73",
    "wearesho-team/message-delivery": "^2.3",
    "yiisoft/yii2": "^2.0.54"
  },
  "autoload": {
    "psr-4": {
      "Wearesho\\Delivery\\Yii2\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wearesho\\Delivery\\Yii2\\Tests\\": "tests/"
    }
  },
  "config": {
    "process-timeout": 1800,
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "lint": "./vendor/bin/phpcs --standard=PSR12 ./src ./tests",
    "phpcbf": "./vendor/bin/phpcbf --standard=PSR12 ./src ./tests",
    "cover": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --coverage-clover coverage.xml",
    "test": "composer run-script test-pgsql",
    "test-pgsql": "./vendor/bin/phpunit"
  },
  "suggest": {
    "yiisoft/yii2-queue": "Need for Delivery\\Yii\\Queue\\Service"
  }
}
